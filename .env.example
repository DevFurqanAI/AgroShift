# GEMINI_API_KEY: Required for server-side Ask AgroShift Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL of the separately hosted AgroShift Python FastAPI backend
# (e.g. https://your-fastapi-service.example.com or http://localhost:8000).
# Leave empty when running standalone without the Python backend.
VITE_API_BASE_URL=""
