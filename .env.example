# GEMINI_API_KEY: Required for server-side Ask AgroShift Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL of the AgroShift Python FastAPI backend.
# Local development example: http://localhost:8000
# Production default when unset: https://agroshift-backend-o6kr.onrender.com
VITE_API_BASE_URL="https://agroshift-backend-o6kr.onrender.com"
